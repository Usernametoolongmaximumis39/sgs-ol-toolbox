{
  "name": "sgs-ol-toolbox",
  "version": "0.6.294",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "node tools/build-public.mjs",
    "build:full": "node tools/build-public.mjs full",
    "build:lite": "node tools/build-public.mjs lite",
    "build:microclient": "node tools/build-microclient.mjs",
    "check:plugins": "node tools/check-plugin-contract.mjs",
    "check:plugin-lifecycle": "node --test tests/plugin-validation.test.js tests/plugin-lifecycle.test.js",
    "test": "node --test tests/*.test.js",
    "check:release": "npm run check:plugins && npm test && npm run build"
  },
  "devDependencies": {
    "esbuild": "^0.25.0",
    "jsdom": "^26.0.0",
    "playwright": "^1.56.0"
  },
  "dependencies": {
    "@hpke/core": "1.10.1",
    "fflate": "0.8.2",
    "html-to-image": "1.11.13"
  },
  "license": "MIT"
}
